# Copy this file to .env and fill in real values, then restart the backend.
# Used to email bioinfo@andersondiagnostics.in whenever Wet Lab marks a new run
# as transferred. Leave SMTP_HOST blank to leave email sending switched off.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left blank.
SMTP_FROM=
# true unless your mail server needs a plain, unencrypted connection.
SMTP_USE_TLS=true

# Who gets the "new transfer" email. Only needs changing if the address itself
# is ever different from bioinfo@andersondiagnostics.in.
BIOINFO_NOTIFY_EMAIL=bioinfo@andersondiagnostics.in
